# ── HOTSPOTS ────────────────────────────────────────────────────────────────
DEF obs1 Solid {
  translation -0.5 -0.5 0.12
  name "obs1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0 0
        emissiveColor 1 0 0
        roughness 1
        metalness 0
      }
      geometry Sphere {
        radius 0.05
      }
    }
  ]
}
DEF obs2 Solid {
  translation 0.0 0.5 0.12
  name "obs2"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0 1 0
        emissiveColor 0 1 0
        roughness 1
        metalness 0
      }
      geometry Sphere {
        radius 0.05
      }
    }
  ]
}
DEF obs3 Solid {
  translation 0.5 -0.5 0.12
  name "obs3"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0 0 1
        emissiveColor 0 0 1
        roughness 1
        metalness 0
      }
      geometry Sphere {
        radius 0.05
      }
    }
  ]
}

# ── COORDINADOR — supervisor sin geometría ──────────────────────────────────
Robot {
  name "coordinador"
  controller "coordinador_enjambre"
  supervisor TRUE
  children [
    Emitter {
      name "emitter"
      channel 2
    }
    Receiver {
      name "receiver"
      channel 1
    }
  ]
}
